# GitHub Copilot API Gateway proxy — routes all LLM traffic locally at $0 cost
OPENAI_API_BASE=http://localhost:5000/v1
OPENAI_API_KEY=copilot

# RAG settings
DOCS_DIR=./data/docs
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4

# Evaluation thresholds (0–1)
MIN_FAITHFULNESS=0.7
MIN_ANSWER_RELEVANCY=0.7
MIN_CONTEXT_RECALL=0.6
MIN_CONTEXT_PRECISION=0.6

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
